{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rescue.invalid/payloads/received.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "enum": [
        "sms",
        "social",
        "form",
        "call_note",
        "csv"
      ]
    },
    "raw_text": {
      "type": "string",
      "minLength": 1
    },
    "lang_hint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contact": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "incident": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,4}-[0-9]{4,6}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional. Incident number shown to volunteers; the per-laptop prefix keeps it unique offline (e.g. A-0147)."
    },
    "sample": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional. True for grader-mode samples; dashboards leave them out of request counts."
    }
  },
  "required": [
    "channel",
    "raw_text",
    "lang_hint",
    "contact"
  ],
  "title": "received payload",
  "description": "Raw text stays in the field DB and cloud records. It is never passed to the engine."
}
