{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rescue.invalid/payloads/escalated.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reason",
    "note"
  ],
  "title": "escalated payload"
}
