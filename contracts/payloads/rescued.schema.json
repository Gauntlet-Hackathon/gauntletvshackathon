{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rescue.invalid/payloads/rescued.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rescued_count": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/people_count_value"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "all",
            "some",
            "nobody"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional (#306). Whether the boat brought out everyone, some, or nobody."
    },
    "destination": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional (#306). Where the people were taken, e.g. a shelter name."
    }
  },
  "required": [
    "rescued_count",
    "note"
  ],
  "title": "rescued payload"
}
