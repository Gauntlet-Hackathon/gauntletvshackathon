  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rescued_count": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/people_count_value"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
